# Backend — Mock3
# Copy to .env and fill in values

# ─── Database ────────────────────────────────────────────────
# Local (Docker):  postgresql://mock3_user:mock3_pass@localhost:5432/mock3_db
# Production:      postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Clerk Auth ──────────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ────────────────────────────────────────────────
# Local:      http://localhost:5173
# Production: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173
